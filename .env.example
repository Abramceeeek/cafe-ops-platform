# .env.example — copy to .env.local, fill in values, never commit .env.local
# (PROJECT_SPEC §17.2)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key     # Edge Functions only
# admin_web (Next.js) reads these browser-exposed vars:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Firebase (Server)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Google Maps
GOOGLE_MAPS_API_KEY=your-maps-key

# Shared staff login password — used ONLY by ops/test scripts (rename-accounts, uat).
# The keys.txt-based scripts (auth-test-*) read STAFF_PASSWORD from keys.txt instead.
# Never hard-code in scripts. Rotate after go-live.
STAFF_PASSWORD=your-shared-staff-password

# Environment flag
APP_ENV=dev   # dev | staging | prod
